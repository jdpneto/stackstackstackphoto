<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Camera permission: required for CaptureService (AVCapture equivalent on Android). -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- RAW capture is used when the hardware supports it; not required — JPEG fallback is used
         on devices without a Bayer RAW-capable camera (e.g. the emulator). (spec §2, §4 table) -->
    <uses-feature android:name="android.hardware.camera2" android:required="true" />
    <uses-feature android:name="android.hardware.camera2.full" android:required="false" />

    <!-- Battery monitoring for CaptureEnvironment. -->
    <uses-permission android:name="android.permission.BATTERY_STATS" />

    <application
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:allowBackup="false"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            FileProvider: shares result files with ACTION_SEND (the share sheet).
            The authority must match the string used in PhotoDetailScreen's FileProvider.getUriForFile call.
            Mirrors the iOS UIActivityViewController that shares the result file URL.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
